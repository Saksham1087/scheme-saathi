# Real Firebase project config (leave unset to run fully on emulators
# with the built-in demo project).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Set to "false" in dev to force production backend while running vite locally.
VITE_USE_EMULATORS=
