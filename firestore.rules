rules_version = '2';

// ==========================================================================
// Firestore Security Rules for Scheme Sathi
//
// Public read: schemes, schemeRules, categories, partners
// Authenticated read/write: user profiles, saved schemes/partners, assessments
// Admin-only: scheme management, admin collections
// ==========================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------
    // Helper functions
    // -------------------------------------------------------------------

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/adminUsers/$(request.auth.uid)).data.role == 'admin';
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // -------------------------------------------------------------------
    // Public collections — anyone can read
    // -------------------------------------------------------------------

    // Schemes
    match /schemes/{schemeId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Scheme eligibility rules
    match /schemeRules/{ruleId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Scheme categories
    match /categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Channel partners
    match /partners/{partnerId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Partner-scheme associations
    match /partnerSchemes/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // -------------------------------------------------------------------
    // Authenticated-only collections
    // -------------------------------------------------------------------

    // Recommendations (global collection, filtered by userId in service layer)
    match /recommendations/{recId} {
      allow read: if isOwner(resource.data.userId);
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    // Assessments (global collection, filtered by userId in service layer)
    match /assessments/{assessmentId} {
      allow read: if isOwner(resource.data.userId);
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    // Translations
    match /translations/{lang} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // -------------------------------------------------------------------
    // User-scoped sub-collections
    // -------------------------------------------------------------------

    // User profiles
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isOwner(userId);
      allow delete: if false;

      // Saved schemes
      match /savedSchemes/{schemeId} {
        allow read, write: if isOwner(userId);
      }

      // Saved partners
      match /savedPartners/{partnerId} {
        allow read, write: if isOwner(userId);
      }

      // Calculator history
      match /calculatorHistory/{calcId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId);
        allow update, delete: if false;
      }

      // Application journeys
      match /applicationJourneys/{journeyId} {
        allow read, write: if isOwner(userId);
      }

      // Documents (DigiLocker / manual uploads)
      match /documents/{docId} {
        allow read, write: if isOwner(userId);
      }
    }

    // -------------------------------------------------------------------
    // Admin collections
    // -------------------------------------------------------------------

    match /adminUsers/{adminId} {
      allow read: if isAdmin();
      allow write: if false; // managed via Firebase Console or admin scripts
    }
  }
}
